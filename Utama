    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4bc70e2c01a94c73b74392e4234840661791215815920" integrity="sha512-L0ha0OXavK/8okipN9F8BtP84dg9DUhPERbBXzwI6dgTA55d2+yweo3pn5CSFYs45/r8md2+xvUPtTdvTNRfjA==" data-cf-beacon='{"version":"2024.11.0","token":"ca0f0a90b977481fbd78e2f9c8cc0f76","r":1,"spa":2}' crossorigin="anonymous"></script>

    <script>
        'use strict';
        const ip = 'play.talven.org';
        const toast = document.querySelector('#toast');
        let toastTimer;
        
        document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(ip);
            toast.textContent = 'IP adresa je kopirana. Vidimo se na Talvenu!';
          } catch {
            toast.textContent = 'Kopiranje nije dostupno. Ručno kopiraj: ' + ip;
          }
          toast.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => { toast.hidden = true; }, 5000);
        }));
        
        const menu = document.querySelector('.menu-toggle');
        const nav = document.querySelector('#navigation');
        
        menu.addEventListener('click', () => { 
            const open = menu.getAttribute('aria-expanded') !== 'true'; 
            menu.setAttribute('aria-expanded', String(open)); 
            nav.classList.toggle('open', open); 
        });
        
        nav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { 
            menu.setAttribute('aria-expanded', 'false'); 
            nav.classList.remove('open'); 
        }));
        
        document.addEventListener('keydown', e => { 
            if(e.key === 'Escape') { 
                nav.classList.remove('open'); 
                menu.setAttribute('aria-expanded', 'false'); 
            }
        });
        
        document.querySelector('#year').textContent = new Date().getFullYear();
        
        async function refreshStatus() {
          const label = document.querySelector('#server-status');
          const count = document.querySelector('#player-count');
          const dot = document.querySelector('#status-dot');
          const note = document.querySelector('#status-note');
          try {
            const response = await fetch('https://api.mcsrvstat.us/3/' + ip, { signal: AbortSignal.timeout(10000) });
            if (!response.ok) throw new Error('Status unavailable');
            const data = await response.json();
            if (typeof data.online !== 'boolean') throw new Error('Invalid status');
            label.textContent = data.online ? 'Server je online' : 'Server je offline';
            dot.className = 'status-dot ' + (data.online ? 'online' : 'offline');
            count.textContent = data.online && Number.isFinite(data.players?.online) ? String(data.players.online) + (Number.isFinite(data.players.max) ? ' / ' + data.players.max : '') : '—';
            note.textContent = 'Status putem mcsrvstat.us · podaci mogu kasniti do 5 minuta.';
            if(data.online && typeof data.version === 'string') document.querySelector('#version-help').textContent = 'Server prijavljuje verziju ' + data.version + '. Za detalje kompatibilnosti pogledaj Discord.';
          } catch {
            label.textContent = 'Status trenutačno nedostupan';
            count.textContent = '—'; dot.className = 'status-dot';
            note.textContent = 'Provjera statusa nije uspjela. To ne znači da je server offline; pokušaj se spojiti u Minecraftu.';
          }
        }
        
        refreshStatus();
        setInterval(() => { if(!document.hidden) refreshStatus(); }, 300000);
    </script>
