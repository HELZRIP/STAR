          unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
        }
        /* latin */
        @font-face {
          font-family: 'Manrope';
          font-style: normal;
          font-weight: 800;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/manrope/v20/xn7gYHE41ni1AdIRggexSg.woff2) format('woff2');
          unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }

        @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap'); 
        
        :root {
            color-scheme: dark;
            --bg: #070e19;
            --panel: #0c1727;
            --ink: #f0f7ff;
            --muted: #a0aec2;
            --cyan: #5ce6ff;
            --line: #223247;
            --heading: 'Barlow Condensed','Arial Narrow',sans-serif
        }

        * {
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 100px
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font: 16px/1.7 'Manrope',Arial,sans-serif
        }

        a {
            color: inherit;
            text-decoration: none
        }

        button {
            font: inherit;
            cursor: pointer
        }

        button,a {
            -webkit-tap-highlight-color: transparent
        }

        button:focus-visible,a:focus-visible {
            outline: 3px solid var(--cyan);
            outline-offset: 6px
        }

        img {
            max-width: 100%;
            display: block
        }

        .wrap {
            width: min(1200px,calc(100% - 80px));
            margin: auto
        }

        .skip {
            position: fixed;
            top: -100px;
            left: 20px;
            background: var(--cyan);
            color: #071421;
            padding: 12px;
            z-index: 20
        }

        .skip:focus {
            top: 12px
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 22px 40px;
            border-bottom: 1px solid var(--line);
            gap: 28px;
            max-width: 1440px;
            margin: auto
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 23px;
            letter-spacing: .16em;
            font-weight: 800;
            line-height: 1.1
        }

        .brand img {
            border-radius: 50%;
            object-fit: cover
        }

        .brand small {
            display: block;
            font-size: 12px;
            letter-spacing: .42em;
            color: var(--muted);
            margin-top: 8px
        }

        .header nav {
            display: flex;
            align-items: center;
            gap: 27px;
            font-size: 14px;
            font-weight: 700
        }

        .header nav a:hover,.text-link:hover {
            color: var(--cyan)
        }

        .nav-discord {
            border: 1px solid #365269;
            padding: 9px 17px
        }

        .menu-toggle {
            display: none
        }

        .hero {
            position: relative;
            display: grid;
            grid-template-columns: 1.08fr 1fr;
            align-items: center;
            min-height: 680px;
            padding-top: 48px;
            padding-bottom: 80px
        }

        .eyebrow {
            font-size: 12px;
            letter-spacing: .2em;
            font-weight: 800;
            color: var(--cyan);
            margin: 0 0 24px;
            display: flex;
            align-items: center;
            gap: 12px
        }

        .line {
            width: 30px;
            height: 1px;
            background: var(--cyan)
        }

        h1,h2,h3,p {
            margin-top: 0
        }

        h1,h2,h3 {
            font-family: var(--heading);
            line-height: 1.03;
            font-weight: 700;
            letter-spacing: -.015em
        }

        h1 {
            font-size: clamp(64px,7.7vw,112px);
            margin-bottom: 24px
        }

        em {
            font-style: normal;
            color: var(--cyan)
        }

        .lead {
            color: var(--muted);
            font-size: 18px;
            line-height: 1.85
        }

        .hero-actions {
            display: flex;
            gap: 24px;
            align-items: center;
            margin: 30px 0
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 24px;
            min-height: 52px;
            padding: 14px 22px;
            font-size: 14px;
            font-weight: 800;
            border: 1px solid transparent;
            transition: background .2s,transform .2s
        }

        .button:hover {
            transform: translateY(-2px)
        }

        .primary {
            background: var(--cyan);
            color: #061727;
            box-shadow: 0 8px 35px #14bfe814
        }

        .primary:hover {
            background: #a3f3ff
        }

        .secondary {
            border-color: #486379;
            background: #13273c;
            color: #e8faff
        }

        .text-link {
            font-size: 14px;
            font-weight: 700
        }

        .copy-ip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 16px 20px;
            background: #0d1928;
            border: 1px solid var(--line);
            color: var(--ink);
            text-align: left;
            width: min(420px,100%)
        }

        .copy-ip:hover {
            border-color: #54cce1
        }

        .copy-ip small {
            display: block;
            font-size: 12px;
            letter-spacing: .17em;
            color: var(--muted)
        }

        .copy-ip strong {
            font-size: 20px;
            font-weight: 600;
            letter-spacing: .03em
        }

        .copy-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: var(--cyan)
        }

        .feedback {
            height: 24px;
            font-size: 13px;
            color: var(--cyan);
            margin: 8px 0 0
        }

        .hero-art {
            position: relative;
            text-align: center;
            padding: 0 0 40px;
            align-self: center
        }

        .hero-art img {
            width: 100%;
            height: auto;
            mix-blend-mode: screen;
            mask-image: radial-gradient(ellipse at center,#000 45%,transparent 72%)
        }

        .art-label {
            position: absolute;
            top: 1%;
            left: 0;
            right: 0;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .45em;
            color: #9ebbd0;
            z-index: 1
        }

        .art-name {
            font-family: var(--heading);
            font-weight: 800;
            font-size: 62px;
            letter-spacing: .2em;
            line-height: 1;
            margin: -22px 0 0;
            position: relative
        }

        .art-name span {
            display: block;
            font-family: 'Manrope',sans-serif;
            font-size: 12px;
            letter-spacing: .3em;
            color: #a8dcea;
            margin-top: 12px
        }

        .hero-bottom {
            position: absolute;
            bottom: 24px;
            display: flex;
            justify-content: space-between;
            width: 100%;
            font-size: 12px;
            letter-spacing: .15em;
            color: #8c9fb4
        }

        .hero-bottom a {
            letter-spacing: .03em;
            font-size: 13px
        }

        .hero-bottom a span {
            color: var(--cyan);
            margin-left: 12px
        }

        .status-bar {
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            background: #0a1422
        }

        .status-inner {
            display: grid;
            grid-template-columns: 1.3fr 1fr 1fr 1fr auto;
            align-items: center;
            gap: 24px;
            padding: 25px 0 10px
        }

        .status-inner small {
            display: block;
            font-size: 12px;
            letter-spacing: .12em;
            color: #879cb4
        }

        .status-inner strong {
            font-size: 16px;
            font-weight: 600
        }

        .server-state {
            display: flex;
            align-items: center;
            gap: 14px
        }

        .status-dot {
            display: block;
            width: 8px;
            height: 8px;
            background: #92a4b8;
            border-radius: 50%
        }

        .status-dot.online {
            background: #60e3ac;
            box-shadow: 0 0 12px #60e3ac55
        }

        .status-dot.offline {
            background: #ff9d82
        }

        .status-note {
            font-size: 12px;
            color: #8293a8;
            margin-top: 0;
            padding-bottom: 12px
        }

        .section {
            padding: 100px 0
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 60px;
            margin-bottom: 45px
        }

        .section-heading>p {
            max-width: 360px;
            margin-bottom: 5px;
            color: var(--muted)
        }

        h2 {
            font-size: clamp(42px,4.3vw,64px);
            margin-bottom: 0
        }

        .features {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line)
        }

        .features article {
            padding: 32px 34px 30px 0
        }

        .features article+article {
            padding-left: 34px;
            border-left: 1px solid var(--line)
        }

        .feature-number {
            font-family: var(--heading);
            font-size: 20px;
            color: #4bb9d5
        }

        .features h3 {
            font-size: 32px;
            margin: 24px 0 12px
        }

        .features p {
            color: var(--muted);
            margin-bottom: 0;
            font-size: 15px
        }

        .play-section {
            background: linear-gradient(115deg,#0c2335,#0b1523 70%);
            border-block:1px solid var(--line);padding: 80px 0
        }

        .play-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 100px
        }

        .muted {
            color: var(--muted);
            max-width: 370px;
            margin: 25px 0
        }

        .steps {
            padding: 0;
            margin: 0;
            list-style: none
        }

        .steps li {
            display: flex;
            gap: 25px;
            padding: 22px 0;
            border-bottom: 1px solid #233c51
        }

        .steps li:first-child {
            padding-top: 0
        }

        .steps li:last-child {
            border-bottom: 0;
            padding-bottom: 0
        }

        .steps li>span {
            color: var(--cyan);
            font-family: var(--heading);
            font-size: 24px
        }

        .steps h3 {
            font-size: 25px;
            margin: 4px 0 10px
        }

        .steps p {
            font-size: 14px;
            color: var(--muted);
            margin: 0
        }

        .steps strong,.steps a {
            color: var(--ink)
        }

        .steps a {
            text-decoration: underline;
            text-underline-offset: 4px
        }

        .ranks {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px
        }

        .rank {
            padding: 28px 20px;
            text-align: center;
            background: linear-gradient(160deg,#132236,#0a1421);
            border: 1px solid #253d52;
            position: relative;
            overflow: hidden
        }

        .rank-symbol {
            font-family: var(--heading);
            color: #82d6f0;
            font-size: 65px;
            line-height: 1.7;
            letter-spacing: -.08em;
            text-shadow: 0 0 35px #2ddfff33
        }

        .rank>span {
            font-size: 12px;
            letter-spacing: .24em;
            color: #7793ac
        }

        .rank h3 {
            font-size: 32px;
            margin: 10px 0
        }

        .rank p {
            font-size: 13px;
            color: #91a5ba;
            margin-bottom: 0
        }

        .rank.immortal {
            border-color: #477b90;
            background: linear-gradient(150deg,#183950,#0b1627)
        }

        .immortal .rank-symbol {
            color: #b4f7ff
        }

        .free-ranks {
            margin-top: 28px;
            border-bottom: 1px solid var(--line);
            padding-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 25px
        }

        .free-ranks>span {
            font-size: 12px;
            letter-spacing: .15em;
            color: var(--cyan);
            white-space: nowrap
        }

        .free-ranks p {
            font-size: 13px;
            color: #b4c3d3;
            margin: 0
        }

        .free-ranks b {
            padding: 0 9px;
            font-weight: 400;
            color: #405b73
        }

        .service-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px
        }

        .service-grid article {
            border: 1px solid var(--line);
            padding: 35px;
            background: #0c1624
        }

        .badge {
            display: inline-block;
            font-size: 12px;
            letter-spacing: .16em;
            color: #a1b5c9;
            border: 1px solid #334359;
            padding: 4px 8px;
            margin-bottom: 22px
        }

        .service-grid h2 {
            font-size: 34px;
            margin-bottom: 18px
        }

        .service-grid p {
            color: var(--muted);
            max-width: 420px;
            font-size: 15px
        }

        .service-grid a {
            color: var(--cyan)
        }

        .rules {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 100px;
            padding: 100px 0
        }

        .rules p:not(.eyebrow) {
            color: var(--muted)
        }

        .final-cta {
            border-block:1px solid #244054;background: radial-gradient(ellipse at bottom,#123b56,transparent 70%),#0b1727;
            text-align: center;
            padding: 76px 0
        }

        .final-cta .eyebrow {
            justify-content: center
        }

        .final-cta h2 {
            font-size: clamp(50px,5vw,76px);
            margin-bottom: 32px
        }

        .final-cta .button {
            min-width: 260px
        }

        .final-cta p:last-child {
            font-size: 13px;
            letter-spacing: .08em;
            color: var(--muted);
            margin: 15px 0 0
        }

        footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 28px;
            padding: 35px 0
        }

        footer p {
            font-size: 12px;
            color: #8192a8;
            margin: 0
        }

        footer>a:last-child {
            font-size: 13px;
            color: #b9c9d8
        }

        .footer-brand {
            font-family: var(--heading);
            font-size: 28px;
            font-weight: 700;
            letter-spacing: .15em;
            line-height: 1
        }

        .footer-brand span {
            display: block;
            font-family: 'Manrope',sans-serif;
            font-size: 12px;
            color: #87a0b8;
            margin-top: 8px;
            letter-spacing: .25em
        }

        .toast {
            position: fixed;
            left: 50%;
            bottom: 24px;
            transform: translateX(-50%);
            background: #e5fbff;
            color: #072033;
            padding: 14px 24px;
            box-shadow: 0 5px 40px #0008;
            font-size: 14px;
            z-index: 30;
            text-align: center;
            width: max-content;
            max-width: 90%
        }

        .toast[hidden] {
            display: none
        }

        @media(min-width: 1450px) {
            .hero {
                min-height:750px
            }
        }

        @media(max-width: 1050px) {
            .header {
                padding:18px 26px
            }

            .header nav {
                gap: 15px;
                font-size: 13px
            }

            .wrap {
                width: calc(100% - 52px)
            }

            .hero-actions {
                gap: 18px;
                flex-wrap: wrap
            }

            .hero {
                min-height: 620px
            }

            .status-inner {
                grid-template-columns: 1.2fr 1fr 1fr
            }

            .status-inner>div:nth-child(4) {
                display: none
            }

            .status-inner>a {
                display: none
            }

            .play-grid,.rules {
                gap: 50px
            }

            .art-name {
                font-size: 48px
            }

            .section-heading {
                gap: 35px
            }
        }

        @media(max-width: 760px) {
            html {
                scroll-padding-top:20px
            }

            .header {
                padding: 16px 22px;
                flex-wrap: wrap
            }

            .brand {
                font-size: 20px
            }

            .brand img {
                width: 40px;
                height: 40px
            }

            .menu-toggle {
                display: flex;
                gap: 12px;
                align-items: center;
                background: transparent;
                border: 1px solid var(--line);
                color: var(--ink);
                padding: 8px 12px;
                font-size: 13px
            }

            .header nav {
                display: none;
                flex-direction: column;
                align-items: stretch;
                width: 100%;
                gap: 0
            }

            .header nav.open {
                display: flex
            }

            .header nav a {
                padding: 12px 4px;
                border-top: 1px solid var(--line);
                font-size: 15px
            }

            .header nav .nav-discord {
                border: 0;
                border-top: 1px solid var(--line)
            }

            .wrap {
                width: calc(100% - 44px)
            }

            .hero {
                padding-top: 42px;
                padding-bottom: 60px;
                grid-template-columns: 1fr;
                min-height: auto
            }

            .hero-content {
                z-index: 1
            }

            .hero h1 {
                font-size: clamp(62px,14vw,96px)
            }

            .lead {
                font-size: 16px
            }

            .hero-art {
                width: min(440px,95%);
                margin: -8px auto 0;
                padding-bottom: 25px
            }

            .hero-art .art-label {
                top: 5%
            }

            .art-name {
                font-size: 48px
            }

            .hero-bottom {
                font-size: 12px;
                bottom: 18px
            }

            .hero-bottom a {
                font-size: 12px
            }

            .status-inner {
                grid-template-columns: 1.25fr 1fr;
                gap: 14px;
                padding-top: 21px
            }

            .status-inner>div:nth-child(3) {
                display: none
            }

            .status-inner strong {
                font-size: 14px
            }

            .status-note {
                font-size: 12px
            }

            .section {
                padding: 65px 0
            }

            .section-heading {
                display: block;
                margin-bottom: 28px
            }

            .section-heading>p {
                margin-top: 24px;
                font-size: 15px
            }

            .eyebrow {
                font-size: 12px;
                letter-spacing: .15em;
                margin-bottom: 20px
            }

            .features {
                grid-template-columns: 1fr
            }

            .features article,.features article+article {
                padding: 24px 0;
                border-left: 0
            }

            .features article+article {
                border-top: 1px solid var(--line)
            }

            .features h3 {
                margin-top: 10px
            }

            .feature-number {
                float: right
            }

            .play-section {
                padding: 55px 0
            }

            .play-grid,.rules {
                grid-template-columns: 1fr;
                gap: 40px
            }

            .ranks {
                grid-template-columns: 1fr 1fr;
                gap: 12px
            }

            .rank {
                padding: 18px 10px
            }

            .rank h3 {
                font-size: 27px
            }

            .rank-symbol {
                font-size: 52px
            }

            .free-ranks {
                display: block
            }

            .free-ranks p {
                margin-top: 12px;
                line-height: 2.1
            }

            .service-grid {
                grid-template-columns: 1fr
            }

            .service-grid article {
                padding: 27px
            }

            .rules {
                padding: 65px 0
            }

            .final-cta {
                padding: 60px 0
            }

            .final-cta h2 {
                font-size: 52px
            }

            footer {
                flex-wrap: wrap;
                padding: 30px 0
            }

            footer>div {
                order: 3;
                width: 100%
            }

            .copy-ip {
                max-width: 100%
            }

            .copy-ip strong {
                font-size: 19px
            }

            .copy-label {
                font-size: 12px
            }

            .hero-actions .text-link {
                font-size: 13px
            }
        }

        @media(prefers-reduced-motion:reduce) {
            html {
                scroll-behavior: auto
            }

            *,*::before,*::after {
                transition: none!important;
                animation: none!important
            }
        }

        .world-gallery {
            margin-top: 70px
        }

        .gallery-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 30px;
            margin-bottom: 25px
        }

        .gallery-heading h3 {
            font-size: 36px;
            margin: 0
        }

        .gallery-heading .eyebrow {
            margin-bottom: 12px
        }

        .gallery-heading>p {
            color: var(--muted);
            font-size: 14px;
            margin: 0
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 20px
        }

        .gallery-grid figure {
            margin: 0;
            background: #0c1727;
            border: 1px solid var(--line);
            min-width: 0
        }

        .gallery-grid .gallery-main {
            grid-column: 1/-1
        }

        .gallery-grid a {
            display: block;
            overflow: hidden
        }

        .gallery-grid img {
            width: 100%;
            height: auto;
            aspect-ratio: 945/483;
            object-fit: cover;
            transition: transform .3s
        }

        .gallery-grid a:hover img {
            transform: scale(1.025)
        }

        .gallery-main img {
            aspect-ratio: 945/482
        }

        .gallery-grid figcaption {
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 5px
        }

        .gallery-grid figcaption span {
            font-size: 12px;
            letter-spacing: .12em;
            color: var(--cyan)
        }

        .gallery-grid figcaption strong {
            font-family: var(--heading);
            font-size: 25px;
            font-weight: 600
        }

        .gallery-main figcaption {
            flex-direction: row;
            align-items: center;
            justify-content: space-between
        }

